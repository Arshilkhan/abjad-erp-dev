CREATE OR REPLACE FUNCTION "public"."amount_in_words"("amount" numeric) RETURNS "text"
    LANGUAGE "plpgsql" IMMUTABLE
    SET "search_path" TO 'public'
    AS $$
DECLARE
  ones text[] := ARRAY['','One','Two','Three','Four','Five','Six','Seven','Eight','Nine'];
  rupees bigint := floor(amount);
  paise int := round((amount - floor(amount)) * 100);
  n bigint; crore bigint; lakh bigint; thousand bigint; hundred int; h int; r int;
  parts text[] := ARRAY[]::text[];
  out_text text;
BEGIN
  IF rupees = 0 AND paise = 0 THEN RETURN 'Zero Rupees Only'; END IF;
  n := rupees;
  crore := n / 10000000; n := n % 10000000;
  lakh := n / 100000; n := n % 100000;
  thousand := n / 1000; n := n % 1000;
  hundred := n;
  IF crore > 0 THEN parts := parts || (public.num_words_below_hundred(crore::int) || ' Crore'); END IF;
  IF lakh > 0 THEN parts := parts || (public.num_words_below_hundred(lakh::int) || ' Lakh'); END IF;
  IF thousand > 0 THEN parts := parts || (public.num_words_below_hundred(thousand::int) || ' Thousand'); END IF;
  IF hundred > 0 THEN
    h := hundred / 100; r := hundred % 100;
    parts := parts || (
      CASE WHEN h > 0 THEN ones[h + 1] || ' Hundred' || CASE WHEN r > 0 THEN ' ' ELSE '' END ELSE '' END
      || CASE WHEN r > 0 THEN public.num_words_below_hundred(r) ELSE '' END
    );
  END IF;
  out_text := array_to_string(parts, ' ') || ' Rupees';
  IF paise > 0 THEN out_text := out_text || ' and ' || public.num_words_below_hundred(paise) || ' Paise'; END IF;
  RETURN out_text || ' Only';
END; $$;


ALTER FUNCTION "public"."amount_in_words"("amount" numeric) OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."can_access_org"("_organization_id" "uuid") RETURNS boolean
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
  SELECT EXISTS (
    SELECT 1
    FROM public.organization_members
    WHERE organization_id = _organization_id
      AND user_id = auth.uid()
  );
$$;


ALTER FUNCTION "public"."can_access_org"("_organization_id" "uuid") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."can_edit_org_panel"("_organization_id" "uuid", "_panel" "text", "_user_id" "uuid" DEFAULT "auth"."uid"()) RETURNS boolean
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
    SELECT
        public.has_org_panel(
            _organization_id,
            _panel,
            _user_id
        )
        AND EXISTS (
            SELECT 1
            FROM public.organization_members om
            WHERE om.organization_id = _organization_id
              AND om.user_id = _user_id
              AND om.role IN (
                  'super_admin'::public.app_role,
                  'admin'::public.app_role,
                  'accountant'::public.app_role,
                  'sales_executive'::public.app_role
              )
        );
$$;


ALTER FUNCTION "public"."can_edit_org_panel"("_organization_id" "uuid", "_panel" "text", "_user_id" "uuid") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."can_edit_panel"("_panel" "text") RETURNS boolean
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
  SELECT public.has_panel(_panel) AND public.can_write();
$$;


ALTER FUNCTION "public"."can_edit_panel"("_panel" "text") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."can_write"("_user_id" "uuid" DEFAULT "auth"."uid"()) RETURNS boolean
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
  SELECT EXISTS (
    SELECT 1 FROM public.user_roles
    WHERE user_id = _user_id AND role IN ('super_admin','admin','accountant','sales_executive')
  );
$$;


ALTER FUNCTION "public"."can_write"("_user_id" "uuid") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."handle_new_user"() RETURNS "trigger"
    LANGUAGE "plpgsql" SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
DECLARE
  user_count INT;
BEGIN
  INSERT INTO public.profiles (id, full_name, email)
  VALUES (NEW.id, COALESCE(NEW.raw_user_meta_data->>'full_name', NEW.email), NEW.email)
  ON CONFLICT (id) DO NOTHING;
  SELECT COUNT(*) INTO user_count FROM auth.users;
  IF user_count = 1 THEN
    INSERT INTO public.user_roles (user_id, role) VALUES (NEW.id, 'super_admin') ON CONFLICT DO NOTHING;
  ELSE
    INSERT INTO public.user_roles (user_id, role) VALUES (NEW.id, 'viewer') ON CONFLICT DO NOTHING;
  END IF;
  RETURN NEW;
END; $$;


ALTER FUNCTION "public"."handle_new_user"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."has_org_panel"("_organization_id" "uuid", "_panel" "text", "_user_id" "uuid" DEFAULT "auth"."uid"()) RETURNS boolean
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
    SELECT
        EXISTS (
            SELECT 1
            FROM public.organization_members om
            WHERE om.organization_id = _organization_id
              AND om.user_id = _user_id
        )
        AND (
            public.has_org_role(
                _organization_id,
                'super_admin'::public.app_role,
                _user_id
            )
            OR
            public.has_org_role(
                _organization_id,
                'admin'::public.app_role,
                _user_id
            )
            OR
            EXISTS (
                SELECT 1
                FROM public.user_panel_permissions upp
                WHERE upp.organization_id = _organization_id
                  AND upp.user_id = _user_id
                  AND upp.panel = _panel
            )
        );
$$;


ALTER FUNCTION "public"."has_org_panel"("_organization_id" "uuid", "_panel" "text", "_user_id" "uuid") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."has_org_role"("_organization_id" "uuid", "_role" "public"."app_role", "_user_id" "uuid" DEFAULT "auth"."uid"()) RETURNS boolean
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
  SELECT EXISTS (
    SELECT 1
    FROM public.organization_members
    WHERE organization_id = _organization_id
      AND user_id = _user_id
      AND role = _role
  );
$$;


ALTER FUNCTION "public"."has_org_role"("_organization_id" "uuid", "_role" "public"."app_role", "_user_id" "uuid") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."has_panel"("_panel" "text", "_user_id" "uuid" DEFAULT "auth"."uid"()) RETURNS boolean
    LANGUAGE "sql" STABLE SECURITY DEFINER
    SET "search_path" TO 'public'
    AS $$
  SELECT public.is_admin(_user_id)
     OR EXISTS (SELECT 1 FROM public.user_panel_permissions WHERE user_id = _user_id AND panel = _panel);
$$;


ALTER FUNCTION "public"."has_panel"("_panel" "text", "_user_id" "uuid") OWNER TO "postgres";


