CREATE OR REPLACE FUNCTION "public"."num_words_below_hundred"("n" integer) RETURNS "text"
    LANGUAGE "plpgsql" IMMUTABLE
    SET "search_path" TO 'public'
    AS $$
DECLARE
  ones text[] := ARRAY['','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen'];
  tens text[] := ARRAY['','','Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety'];
BEGIN
  IF n < 20 THEN RETURN ones[n + 1]; END IF;
  RETURN tens[(n / 10) + 1] || CASE WHEN n % 10 > 0 THEN ' ' || ones[(n % 10) + 1] ELSE '' END;
END; $$;


ALTER FUNCTION "public"."num_words_below_hundred"("n" integer) OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."recalc_invoice_paid"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    SET "search_path" TO 'public'
    AS $$
DECLARE
  v_invoice_id UUID;
  v_paid NUMERIC;
  v_total NUMERIC;
BEGIN
  v_invoice_id := COALESCE(NEW.invoice_id, OLD.invoice_id);
  SELECT COALESCE(SUM(amount),0) INTO v_paid FROM public.payments WHERE invoice_id = v_invoice_id;
  SELECT grand_total INTO v_total FROM public.invoices WHERE id = v_invoice_id;
  UPDATE public.invoices SET
    amount_paid = v_paid,
    status = CASE
      WHEN v_paid >= COALESCE(v_total,0) AND COALESCE(v_total,0) > 0 THEN 'paid'
      WHEN v_paid > 0 THEN 'partial'
      ELSE COALESCE((SELECT status FROM public.invoices WHERE id = v_invoice_id), 'sent')
    END
  WHERE id = v_invoice_id;
  RETURN NULL;
END; $$;


ALTER FUNCTION "public"."recalc_invoice_paid"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."recalc_invoice_totals"("_invoice_id" "uuid") RETURNS "void"
    LANGUAGE "plpgsql"
    SET "search_path" TO 'public'
    AS $$
DECLARE
  inv public.invoices%ROWTYPE;
  item_net numeric := 0; item_tax numeric := 0; item_disc numeric := 0;
  extra numeric := 0; charges numeric := 0; sub numeric; pre numeric; grand numeric;
BEGIN
  SELECT * INTO inv FROM public.invoices WHERE id = _invoice_id;
  IF NOT FOUND THEN RETURN; END IF;

  SELECT COALESCE(SUM((GREATEST(quantity - COALESCE(rejected_quantity,0),0) * unit_rate)
                      * (1 - COALESCE(discount_pct,0)/100)), 0),
         COALESCE(SUM(COALESCE(tax_amount,0)), 0),
         COALESCE(SUM(COALESCE(discount_amount,0)), 0)
    INTO item_net, item_tax, item_disc
    FROM public.invoice_items WHERE invoice_id = _invoice_id;

  IF NOT EXISTS (SELECT 1 FROM public.invoice_items WHERE invoice_id = _invoice_id) THEN
    RETURN; -- nothing to derive from yet
  END IF;

  extra := GREATEST(COALESCE(inv.discount_amount,0) - item_disc, 0);
  charges := COALESCE(inv.freight,0) + COALESCE(inv.packing_charges,0) + COALESCE(inv.other_charges,0)
           + COALESCE(inv.transportation_charges,0) + COALESCE(inv.delivery_charges,0);
  sub := item_net + charges - extra;
  pre := sub + item_tax;
  grand := round(pre);

  UPDATE public.invoices SET
    net_value = item_net,
    discount_amount = item_disc + extra,
    subtotal = sub,
    sgst_amount = CASE WHEN COALESCE(is_igst,false) THEN 0 ELSE item_tax / 2 END,
    cgst_amount = CASE WHEN COALESCE(is_igst,false) THEN 0 ELSE item_tax / 2 END,
    igst_amount = CASE WHEN COALESCE(is_igst,false) THEN item_tax ELSE 0 END,
    round_off = grand - pre,
    grand_total = grand,
    amount_in_words = public.amount_in_words(grand)
  WHERE id = _invoice_id;
END; $$;


ALTER FUNCTION "public"."recalc_invoice_totals"("_invoice_id" "uuid") OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."recalc_sales_document_totals"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    SET "search_path" TO 'public'
    AS $_$
DECLARE
  parent_id uuid; parent_table text := TG_ARGV[0];
  item_net numeric := 0; item_tax numeric := 0; item_disc numeric := 0;
  parent_row record; charges numeric := 0; sub numeric; pre numeric; grand numeric;
BEGIN
  parent_id := COALESCE(NEW.invoice_id, OLD.invoice_id);
  EXECUTE format('SELECT * FROM public.%I WHERE id = $1', parent_table) INTO parent_row USING parent_id;
  IF parent_row IS NULL THEN RETURN NULL; END IF;
  EXECUTE format('SELECT COALESCE(SUM((GREATEST(quantity - COALESCE(rejected_quantity,0),0) * unit_rate) * (1 - COALESCE(discount_pct,0)/100)),0), COALESCE(SUM(discount_amount),0), COALESCE(SUM(tax_amount),0) FROM public.%I WHERE invoice_id = $1', TG_TABLE_NAME)
    INTO item_net, item_disc, item_tax USING parent_id;
  charges := COALESCE(parent_row.freight,0) + COALESCE(parent_row.packing_charges,0) + COALESCE(parent_row.other_charges,0) + COALESCE(parent_row.transportation_charges,0) + COALESCE(parent_row.delivery_charges,0);
  sub := item_net + charges; pre := sub + item_tax; grand := round(pre);
  EXECUTE format('UPDATE public.%I SET net_value=$1, discount_amount=$2, subtotal=$3, sgst_amount=$4, cgst_amount=$5, igst_amount=$6, round_off=$7, grand_total=$8, amount_in_words=public.amount_in_words($8) WHERE id=$9', parent_table)
    USING item_net, item_disc, sub,
      CASE WHEN COALESCE(parent_row.is_igst,false) THEN 0 ELSE item_tax/2 END,
      CASE WHEN COALESCE(parent_row.is_igst,false) THEN 0 ELSE item_tax/2 END,
      CASE WHEN COALESCE(parent_row.is_igst,false) THEN item_tax ELSE 0 END,
      grand-pre, grand, parent_id;
  RETURN NULL;
END; $_$;


ALTER FUNCTION "public"."recalc_sales_document_totals"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."tg_invoice_item_amounts"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    SET "search_path" TO 'public'
    AS $$
DECLARE
  qty numeric; gross numeric; disc numeric; net numeric; tax numeric;
BEGIN
  qty := GREATEST(COALESCE(NEW.quantity,0) - COALESCE(NEW.rejected_quantity,0), 0);
  NEW.accepted_quantity := qty;
  gross := qty * COALESCE(NEW.unit_rate,0);
  disc := gross * COALESCE(NEW.discount_pct,0) / 100;
  net := gross - disc;
  tax := net * COALESCE(NEW.tax_pct,0) / 100;
  NEW.discount_amount := disc;
  NEW.tax_amount := tax;
  NEW.total_amount := net + tax;
  RETURN NEW;
END; $$;


ALTER FUNCTION "public"."tg_invoice_item_amounts"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."tg_organizations_updated_at"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    SET "search_path" TO 'public'
    AS $$
BEGIN
  NEW.updated_at = now();
  RETURN NEW;
END;
$$;


ALTER FUNCTION "public"."tg_organizations_updated_at"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."tg_recalc_from_items"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    SET "search_path" TO 'public'
    AS $$
BEGIN
  PERFORM public.recalc_invoice_totals(COALESCE(NEW.invoice_id, OLD.invoice_id));
  RETURN NULL;
END; $$;


ALTER FUNCTION "public"."tg_recalc_from_items"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."tg_recalc_on_invoice_change"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    SET "search_path" TO 'public'
    AS $$
BEGIN
  IF NEW.freight IS DISTINCT FROM OLD.freight
     OR NEW.packing_charges IS DISTINCT FROM OLD.packing_charges
     OR NEW.other_charges IS DISTINCT FROM OLD.other_charges
     OR NEW.transportation_charges IS DISTINCT FROM OLD.transportation_charges
     OR NEW.delivery_charges IS DISTINCT FROM OLD.delivery_charges
     OR NEW.is_igst IS DISTINCT FROM OLD.is_igst
     OR NEW.discount_amount IS DISTINCT FROM OLD.discount_amount THEN
    PERFORM public.recalc_invoice_totals(NEW.id);
  END IF;
  RETURN NULL;
END; $$;


ALTER FUNCTION "public"."tg_recalc_on_invoice_change"() OWNER TO "postgres";


CREATE OR REPLACE FUNCTION "public"."tg_set_updated_at"() RETURNS "trigger"
    LANGUAGE "plpgsql"
    SET "search_path" TO 'public'
    AS $$
BEGIN NEW.updated_at = now(); RETURN NEW; END; $$;


ALTER FUNCTION "public"."tg_set_updated_at"() OWNER TO "postgres";

SET default_tablespace = '';

SET default_table_access_method = "heap";


CREATE TABLE IF NOT EXISTS "public"."backup_history" (
    "id" "uuid" DEFAULT "gen_random_uuid"() NOT NULL,
    "started_at" timestamp with time zone DEFAULT "now"() NOT NULL,
    "finished_at" timestamp with time zone,
    "status" "text" DEFAULT 'running'::"text" NOT NULL,
    "trigger_source" "text" DEFAULT 'manual'::"text" NOT NULL,
    "invoice_count" integer,
    "file_name" "text",
    "file_size" bigint,
    "drive_file_id" "text",
    "drive_link" "text",
    "error" "text",
    "created_by" "uuid",
    "organization_id" "uuid" NOT NULL,
    CONSTRAINT "backup_history_status_check" CHECK (("status" = ANY (ARRAY['running'::"text", 'success'::"text", 'failed'::"text"])))
);


ALTER TABLE "public"."backup_history" OWNER TO "postgres";


CREATE TABLE IF NOT EXISTS "public"."backup_settings" (
    "id" "uuid" DEFAULT "gen_random_uuid"() NOT NULL,
    "frequency" "text" DEFAULT 'off'::"text" NOT NULL,
    "hour_utc" integer DEFAULT 20 NOT NULL,
    "last_run_at" timestamp with time zone,
    "created_at" timestamp with time zone DEFAULT "now"() NOT NULL,
    "updated_at" timestamp with time zone DEFAULT "now"() NOT NULL,
    "organization_id" "uuid" NOT NULL,
    CONSTRAINT "backup_settings_frequency_check" CHECK (("frequency" = ANY (ARRAY['off'::"text", 'daily'::"text", 'weekly'::"text", 'monthly'::"text"]))),
    CONSTRAINT "backup_settings_hour_utc_check" CHECK ((("hour_utc" >= 0) AND ("hour_utc" <= 23)))
);


ALTER TABLE "public"."backup_settings" OWNER TO "postgres";


